[Unit]
Description=Crucible private beta application
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=crucible
Group=crucible
WorkingDirectory=/opt/crucible/current
EnvironmentFile=/etc/crucible/runtime.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# Configuration only; migrations and build admission are explicit release steps.
ExecStartPre=/opt/crucible/current/.venv/bin/python -B -m scripts.beta_preflight
ExecStart=/opt/crucible/current/.venv/bin/python -B -m uvicorn crucible.app:create_app --factory --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log --log-level warning --timeout-keep-alive 5 --timeout-graceful-shutdown 35
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=45
# Let Uvicorn finish bounded child work before killing any remaining workers.
KillMode=mixed
UMask=0077
StateDirectory=crucible
StateDirectoryMode=0700
RuntimeDirectory=crucible
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
LimitCORE=0
LimitNOFILE=8192
TasksMax=128
# Initial 4 GiB host envelope; measure real workload before changing these.
MemoryHigh=2500M
MemoryMax=3G
OOMPolicy=stop
StandardOutput=journal
StandardError=journal
LogNamespace=crucible
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
