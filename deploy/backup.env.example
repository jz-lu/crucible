# systemd EnvironmentFile syntax; never source a secrets file as shell code.
# Actual file: /etc/crucible/backup.env, root:root 0600; see beta-host.txt for directory ownership.
# No values are loaded until explicitly installed/configured by the operator.
RESTIC_REPOSITORY=
# Example repository: s3:https://REGION.digitaloceanspaces.com/PRIVATE_BUCKET/crucible
RESTIC_PASSWORD_FILE=/etc/crucible/restic-password
AWS_SHARED_CREDENTIALS_FILE=/etc/crucible/backup-aws-credentials
AWS_PROFILE=crucible-backup
AWS_DEFAULT_REGION=

# Dedicated PostgreSQL backup credentials, verified TLS, no password in a URI.
PGSERVICEFILE=/etc/crucible/backup-pg-service.conf
PGPASSFILE=/etc/crucible/backup-pgpass
PGSERVICE=crucible-backup
PGCONNECT_TIMEOUT=5

# Exact files backed up; no recursive copy of .local or unrelated configuration.
CRUCIBLE_BACKUP_RUNTIME_ENV=/etc/crucible/runtime.env
CRUCIBLE_BACKUP_RELEASE_MANIFEST=/opt/crucible/current/RELEASE.json
CRUCIBLE_BACKUP_LOCK=/run/crucible-backup/backup.lock
