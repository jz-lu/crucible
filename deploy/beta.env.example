# Hosted beta configuration template. This file is not loaded automatically.
# Store actual values outside Git in the deployment's protected environment.
# See docs/beta-launch.txt. Empty required fields deliberately prevent startup.
# App Platform is the preferred target; platform paths/proxy settings still need
# adaptation and validation. This template is not a deployable App Platform spec.
CRUCIBLE_ENV=production
CRUCIBLE_ACCESS_MODE=beta
CRUCIBLE_ALLOW_SELF_REVIEW=false
CRUCIBLE_ORIGIN=https://crucible.fail

# Identity-only GitHub sign-in. Separate OAuth apps/credentials for local and
# hosted origins; never request repository access. Exact callback URL:
# https://crucible.fail/api/auth/github/callback (wildcard matching disabled).
# Leave disabled until the real provider credentials and callback are configured.
CRUCIBLE_GITHUB_ENABLED=false
CRUCIBLE_GITHUB_CLIENT_ID=
CRUCIBLE_GITHUB_CLIENT_SECRET=

# PostgreSQL private hostname, dedicated application role, provider CA:
# postgresql+psycopg://USER:ENCODED_PASSWORD@PRIVATE_HOST:PORT/DATABASE?sslmode=verify-full&sslrootcert=/etc/crucible/database-ca.crt
DATABASE_URL=
# Preserve the original secret when migrating existing verifiers. This is NOT
# a request to generate a fresh key over an existing database.
CRUCIBLE_SECRET=
CRUCIBLE_DATA_DIR=/var/lib/crucible

# Stable existing account UUIDs; membership must be granted separately.
CRUCIBLE_REVIEWER_IDS=
CRUCIBLE_ACCESS_ADMIN_IDS=
# Exact CURRENT releases, explicitly reviewed for availability on this host.
CRUCIBLE_BETA_RELEASES=

# Single application process. These are per-process limits, not a shared queue.
CRUCIBLE_GENERATION_CONCURRENCY=2
CRUCIBLE_GENERATION_PER_ACCOUNT=1
CRUCIBLE_AUTH_CONCURRENCY=2

CRUCIBLE_MAIL_BACKEND=smtp
CRUCIBLE_MAIL_FROM=
CRUCIBLE_SMTP_HOST=
CRUCIBLE_SMTP_PORT=587
CRUCIBLE_SMTP_USERNAME=
CRUCIBLE_SMTP_PASSWORD=
CRUCIBLE_SMTP_STARTTLS=true

# Also set reviewed native backend paths when assembling the immutable release.
# Keep executable artifacts separate from /var/lib/crucible user data.
# Do not copy the developer's entire .local directory into a build image.
PYTHONDONTWRITEBYTECODE=1
