# App Platform runtime values, not a shell script or deployable secret file.
# Required blank values deliberately prevent startup. Copy values into encrypted
# runtime-only provider settings; never put real credentials in this example.
CRUCIBLE_ENV=production
CRUCIBLE_ACCESS_MODE=beta
CRUCIBLE_ALLOW_SELF_REVIEW=false
CRUCIBLE_ORIGIN=https://crucible.fail
PORT=8080
CRUCIBLE_DATA_DIR=/tmp/crucible

# Use the actual dedicated application role and managed PostgreSQL host/port.
# URL-encode the username/password. Require verified TLS with the provider CA.
# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=verify-full&sslrootcert=/tmp/crucible/database-ca.crt
DATABASE_URL=
# Multiline provider certificate. The image writes it to the fixed path above.
CRUCIBLE_DATABASE_CA_PEM=
# Preserve the original secret with migrated records. Use a different synthetic
# secret only for a disposable test database, never over migrated user data.
CRUCIBLE_SECRET=

# Exact account UUIDs, not usernames. Configure membership separately.
CRUCIBLE_REVIEWER_IDS=
CRUCIBLE_ACCESS_ADMIN_IDS=
# Blank uses the packaged reviewed list; optional exact subset restricts it.
# Use "none" to disable new issuance. See docs/beta-release-policy.txt.
CRUCIBLE_BETA_RELEASES=
CRUCIBLE_GENERATION_CONCURRENCY=2
CRUCIBLE_GENERATION_PER_ACCOUNT=1
CRUCIBLE_AUTH_CONCURRENCY=2

# Enable after supplying the registered application's actual values.
# Callback: https://crucible.fail/api/auth/github/callback
CRUCIBLE_GITHUB_ENABLED=false
CRUCIBLE_GITHUB_CLIENT_ID=
CRUCIBLE_GITHUB_CLIENT_SECRET=

# Invitation/recovery delivery requires a verified sender and working SMTP TLS.
CRUCIBLE_MAIL_BACKEND=smtp
CRUCIBLE_MAIL_FROM=
CRUCIBLE_SMTP_HOST=
CRUCIBLE_SMTP_PORT=587
CRUCIBLE_SMTP_USERNAME=
CRUCIBLE_SMTP_PASSWORD=
CRUCIBLE_SMTP_STARTTLS=true

# Native paths and nonroot entrypoint are already configured by the image.
# Keep the service's run-command override blank.
