# Local mode needs no environment file; run.sh generates a private .local/server.key.
# To use these options, export them in the process environment. This file is not sourced.
CRUCIBLE_ENV=development
CRUCIBLE_ORIGIN=http://127.0.0.1:8000
# DATABASE_URL=postgresql+psycopg://crucible:password@localhost/crucible
# Production requires an HTTPS origin, PostgreSQL, and a persistent random secret:
# CRUCIBLE_SECRET=<base64 encoding of at least 32 random bytes>
# Optional data directory; includes the database, key, and local reviewer configuration.
# CRUCIBLE_DATA_DIR=/private/path/to/crucible-data
# Reviewers default to none. Use stable existing account UUIDs, never handles.
# Production uses this explicit comma-separated setting; an empty value disables review access.
# When set, this overrides the local reviewers.json file (which production ignores).
# CRUCIBLE_REVIEWER_IDS=00000000-0000-0000-0000-000000000001
# Local alternative: python -m crucible.manage grant-reviewer --handle EXISTING_HANDLE
# This writes private reviewers.json under CRUCIBLE_DATA_DIR (default .local).
# Restart the server after changing reviewer configuration. Do not commit the file.
