# Local mode needs no environment file; run.sh generates a private .local/server.key.
# To use these options, export them in the process environment. This file is not sourced.
# Accepted values are exactly development or production; unset defaults to development.
CRUCIBLE_ENV=development
CRUCIBLE_ORIGIN=http://127.0.0.1:8000
# DATABASE_URL=<private PostgreSQL connection string>
# Production requires an HTTPS origin, PostgreSQL, and a persistent random secret:
# CRUCIBLE_SECRET=<base64 encoding of at least 32 random bytes>
# Optional data directory; includes the database, key, and local reviewer configuration.
# CRUCIBLE_DATA_DIR=/private/path/to/crucible-data
# Reviewers default to none. Use stable existing account UUIDs, never handles.
# Production uses this explicit comma-separated setting; an empty value disables review access.
# When set, this overrides the local reviewers.json file (which production ignores).
# CRUCIBLE_REVIEWER_IDS=00000000-0000-0000-0000-000000000001
# Local alternative: python -m crucible.manage grant-reviewer --handle EXISTING_HANDLE
# This writes private reviewers.json under CRUCIBLE_DATA_DIR (default .local).
# Restart the server after changing reviewer configuration. Do not commit the file.
# Development-only UI workflow testing by an already configured reviewer:
# CRUCIBLE_ALLOW_SELF_REVIEW=true
# Defaults false. Exact true/false only; production refuses true at startup.
# Self-review decisions are marked test-only and cannot earn admission credit
# or satisfy the independent implementation-admission check.

# Local access stays open by default; existing accounts are not enrolled or blocked
# automatically. To test the gate, explicitly grant existing accounts first; see
# docs/private-beta-setup.txt. Production requires beta while publication is pending.
CRUCIBLE_ACCESS_MODE=open
# Optional for browser/API invitation administration: stable account UUIDs.
# These are separate from reviewers. Trusted operator CLI commands need no admin IDs.
# CRUCIBLE_ACCESS_ADMIN_IDS=<comma-separated existing account UUIDs>

# Per application process, with immediate 503/Retry-After when generation is busy.
# These limits do not imply a measured participant capacity. Start with one process.
CRUCIBLE_GENERATION_CONCURRENCY=2
CRUCIBLE_GENERATION_PER_ACCOUNT=1
# Separate admission for expensive password operations; does not share generation slots.
CRUCIBLE_AUTH_CONCURRENCY=2
# Each capacity must be 1..32; per-account generation cannot exceed the total.

# Hosted beta challenge issuance (including DH/RSA) requires a reviewed allowlist.
# Empty by default. Comma-separated scheme_id@version; this does not grant admission
# or bypass source/artifact checks. Example of syntax, not an approval:
# CRUCIBLE_BETA_RELEASES=ml-kem@packed-research-v3

# No email is sent unless a transport is explicitly configured.
CRUCIBLE_MAIL_BACKEND=disabled
# Development-only mailbox verification: writes private .eml files, sends no email.
# CRUCIBLE_MAIL_BACKEND=local
# CRUCIBLE_MAIL_OUTBOX_DIR=.local/mail-outbox
# CRUCIBLE_MAIL_FROM=crucible@example.invalid
# Production uses an explicitly configured SMTP service with STARTTLS.
# Supply credentials through the deployment secret store, never this tracked file.
# CRUCIBLE_MAIL_BACKEND=smtp
# CRUCIBLE_MAIL_FROM=<verified sender address>
# CRUCIBLE_SMTP_HOST=<SMTP host>
# CRUCIBLE_SMTP_PORT=587
# CRUCIBLE_SMTP_USERNAME=<SMTP username, if required>
# CRUCIBLE_SMTP_PASSWORD=<SMTP password, if required>
# CRUCIBLE_SMTP_STARTTLS=true
