# Local mode needs no environment file; run.sh generates a private .local/server.key.
# To use these options, export them in the process environment. This file is not sourced.
CRUCIBLE_ENV=development
CRUCIBLE_ORIGIN=http://127.0.0.1:8000
# DATABASE_URL=postgresql+psycopg://crucible:password@localhost/crucible
# Production requires an HTTPS origin, PostgreSQL, and a persistent random secret:
# CRUCIBLE_SECRET=<base64 encoding of at least 32 random bytes>
